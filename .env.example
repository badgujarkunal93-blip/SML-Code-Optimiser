# Algorand Testnet & x402 Configuration
PORT=3001
ALGORAND_NETWORK=testnet
ALGORAND_API_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
USDC_ASSET_ID=31566704

# Development Mode Payment Bypass Flag
DEV_BYPASS_PAYMENT=true
NEXT_PUBLIC_DEV_BYPASS_PAYMENT=true

# Service Wallet (Create via Pera Wallet)
ALGORAND_SERVICE_ADDRESS=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ALGORAND_SERVICE_MNEMONIC=your_25_word_mnemonic_here

# Plausible Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# LLM & Execution Services
GROQ_API_KEY=your_groq_api_key_here
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=

# Security & Resource Limits
MAX_SOURCE_CODE_BYTES=100000
EXECUTION_TIMEOUT_SECONDS=5
MAX_EXECUTION_OUTPUT_BYTES=1048576
PISTON_RUNTIME_CACHE_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=15

# Benchmarking Parameters
BENCHMARK_WARMUP_RUNS=2
BENCHMARK_MEASUREMENT_RUNS=5

# Firebase Configuration
FIREBASE_PROJECT_ID=optichain-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@optichain-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Frontend Client Public Variables
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ALGORAND_API_URL=https://testnet-api.algonode.cloud
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyOptiChainDemoKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=optichain-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=optichain-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=optichain-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
